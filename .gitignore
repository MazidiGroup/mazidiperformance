# ── OS / editor cruft ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.log

# ── Claude Code local (per-developer) settings ────────────────────
# Shared .claude/settings.json (if added) stays tracked; the local
# override is per-developer and must not be committed.
.claude/settings.local.json

# ── SwiftPM ───────────────────────────────────────────────────────
.build/
.swiftpm/
Package.resolved

# ── Xcode: generated project + user/derived data ──────────────────
# project.yml is the canonical project source (docs/BUILD_AND_TEST.md);
# the .xcodeproj is produced by `xcodegen generate` and never committed.
*.xcodeproj/
# App/Info.plist is generated by XcodeGen from the `info:` block in
# project.yml — regenerate it, don't track it.
App/Info.plist
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# ── Media not committed to Git (handoff rule) ─────────────────────
# Do not add the complete production animation library to Git.
production-animation-library/
full-animation-library/
*.mov

# ── Content-pipeline working area (ADR-0010) ──────────────────────
# All generated audit/manifest/report/staging output from the exercise
# content pipeline; the read-only source library is never extracted
# anywhere tracked.
.content-pipeline-work/

# ── Local databases (never commit client data) ────────────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
